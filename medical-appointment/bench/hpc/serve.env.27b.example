# serve.env for the 27B on the pod, laptop endpoint (copy over serve.env once the pod serves;
# the supervisor re-reads it on every restart of api.py). POD_ID = the id in the RunPod
# Connect panel; port 8000 must be exposed as an HTTP port for the proxy URL to work.
REQUEST_DUMP_DIR="C:/Users/edlun/Desktop/lucky shots/NordicCupAI/medical-appointment/request_dump"
LLM_BACKEND=vllm
LLM_URL=https://POD_ID-8000.proxy.runpod.net/v1
LLM_MODEL=Qwen/Qwen3.8-27B
LLM_VARIANT=units-fewshot
LLM_NO_THINK=vllm
LLM_TIMEOUT=25
LLM_DEADLINE=40
LLM_FALLBACK_URL=http://localhost:11434
LLM_FALLBACK_MODEL=qwen3:4b
# clause-level units: +0.015 / +0.017 paired on the two 27Bs (findings log entry 48)
UNIT_SPLIT=clause-and

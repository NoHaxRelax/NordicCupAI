[Unit]
Description=Full fast1m strategy on former seed endpoint
After=network-online.target

[Service]
WorkingDirectory=/opt/fast1m-endpoint/nightsim/serve
Environment=PYTHONPATH=/opt/fast1m-endpoint
Environment=FAST1M_LOG=/var/log/fast1m-9064.jsonl
ExecStart=/opt/nordiccup/.venv/bin/uvicorn fast1m_server:app --host 0.0.0.0 --port 9064 --workers 1 --no-access-log
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
